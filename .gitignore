# Python caches and build artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/

# Editor and OS files
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Local scratch and temporary files
*.tmp
*.temp
*.log
.ipynb_checkpoints/

# TensorBoard event files
events.out.tfevents.*

# Version / development documents (kept locally, not committed)
docs/versions/*
!docs/versions/*_results.md

# Generated run artifacts: ignore everything under data/ (runs, eval, previous_runs, AND
# secured_data). Secured snapshots and frozen pools are managed by the securing process and its
# ADOPTED.md manifests; their SHA-256 pins are the integrity mechanism, not git. Committing large
# .pt/.pkl binaries would bloat the repo irreversibly, so data/secured_data/ is intentionally NOT
# re-included here (the prior !data/secured_data/ negation was removed in v2.7.4 staging).
data/*

# Close-out tooling: the manifest + staging script that BUILD the commit, not artifacts of it.
.close_tooling/
